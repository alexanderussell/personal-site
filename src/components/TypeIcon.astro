---
/**
 * Content-type glyph. One icon per content type, drawn from Lucide.
 *
 * These replaced hand-plotted pixel-art paths: at 14–16px the pixel glyphs
 * turned to mush and read as noise beside a label. Lucide's 24px grid and
 * uniform 2px stroke stay legible at the sizes this actually renders at.
 */
import { PenLine, BookOpen, FlaskConical } from 'lucide-astro';

interface Props {
  type: 'note' | 'guide' | 'experiment';
  class?: string;
}

const { type, class: className = 'size-4' } = Astro.props;

const icons = {
  note: PenLine,
  guide: BookOpen,
  experiment: FlaskConical,
} as const;

const Icon = icons[type];
---

<Icon class={className} aria-hidden="true" />
