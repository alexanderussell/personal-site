---
import CaseStudyCard from './CaseStudyCard.astro';
import type { Role } from '../data/roles';

type CaseStudy = {
  slug: string;
  title: string;
  description: string;
  company: string;
  role?: string;
  timeline?: string;
  tags?: string[];
};

interface Props {
  roles: Role[];
  caseStudies: CaseStudy[];
}

const { roles, caseStudies } = Astro.props;

/**
 * Format a role's date range. Returns undefined when there is nothing to show,
 * so the rail collapses rather than rendering an empty or half-filled label.
 * Roles are seeded without dates until they're confirmed — see src/data/roles.ts.
 */
function dateRange(role: Role): string | undefined {
  if (!role.start && role.end !== null) return undefined;
  if (!role.start && role.end === null) return 'Now';
  return role.end === null ? `${role.start}–Now` : role.end ? `${role.start}–${role.end}` : role.start;
}
---

<div class="work-timeline">
  {roles.map((role, index) => {
    const range = dateRange(role);
    const studies = caseStudies.filter((study) => study.company === role.company);
    const isLast = index === roles.length - 1;

    return (
      <section class="work-role">
        <div class="work-role__rail" aria-hidden="true">
          <span class="work-role__marker"></span>
          {!isLast && <span class="work-role__line"></span>}
        </div>

        <div class="work-role__body">
          <div class="work-role__header">
            {range && (
              <span class="work-role__range font-mono text-[11px] uppercase tracking-[0.1em] text-text-secondary">
                {range}
              </span>
            )}
            <h2 class="work-role__company font-heading">
              {role.url ? (
                <a href={role.url} target="_blank" rel="noopener noreferrer">{role.company}</a>
              ) : (
                role.company
              )}
            </h2>
            {role.title && (
              <p class="work-role__title font-mono text-[13px] text-text-secondary">{role.title}</p>
            )}
          </div>

          <p class="work-role__narrative text-text-secondary mt-2 leading-7">{role.narrative}</p>

          {studies.length > 0 && (
            <div class="work-role__studies">
              {studies.map((study) => (
                <CaseStudyCard
                  href={`/work/${study.slug}`}
                  title={study.title}
                  description={study.description}
                  role={study.role}
                  timeline={study.timeline}
                  tags={study.tags}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    );
  })}
</div>

<style>
  .work-timeline {
    display: flex;
    flex-direction: column;
  }

  .work-role {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .work-role {
      grid-template-columns: 1.5rem 1fr;
      column-gap: 1.25rem;
    }
  }

  /* The rail is decorative structure, hidden on mobile where the horizontal
     space is better spent on the narrative. */
  .work-role__rail {
    display: none;
    position: relative;
  }

  @media (min-width: 640px) {
    .work-role__rail {
      display: block;
    }
  }

  .work-role__marker {
    position: absolute;
    top: 0.45rem;
    left: 0.25rem;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-text-secondary);
  }

  .work-role__line {
    position: absolute;
    top: 1.35rem;
    bottom: -2.5rem;
    left: 0.46rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .work-role__company {
    font-size: 1.375rem;
    line-height: 1.3;
    margin-top: 0.125rem;
  }

  .work-role__company a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .work-role__company a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .work-role__narrative {
    max-width: 42rem;
  }

  .work-role__studies {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .work-role__studies {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
