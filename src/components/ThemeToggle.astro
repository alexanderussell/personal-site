---
/**
 * Theme cycle: system → light → dark → system.
 *
 * Addressed by data attribute rather than by id. The component renders twice
 * (sidebar and mobile bar), and with ids the second instance was unreachable
 * via getElementById — every icon stayed `hidden` and the button collapsed to
 * 0×0. Astro bundles this script once no matter how many instances exist, so
 * one querySelectorAll pass drives all of them.
 */
import { Sun, Moon, Monitor } from 'lucide-astro';
---

<button
  data-theme-toggle
  type="button"
  aria-label="Toggle theme"
  class="text-text-secondary hover:text-text-primary cursor-pointer transition-colors"
>
  <Sun data-theme-icon="light" class="hidden size-5" aria-hidden="true" />
  <Moon data-theme-icon="dark" class="hidden size-5" aria-hidden="true" />
  <Monitor data-theme-icon="system" class="hidden size-5" aria-hidden="true" />
</button>

<script>
  // In-memory copy so the toggle still works for the session when storage is
  // blocked (private mode, site data disabled) — it just won't persist.
  let memoryTheme: string | null = null;

  function getTheme() {
    try {
      return localStorage.getItem('theme') || 'system';
    } catch {
      return memoryTheme || 'system';
    }
  }

  function storeTheme(theme: string) {
    memoryTheme = theme === 'system' ? null : theme;
    try {
      if (theme === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', theme);
    } catch {
      // Storage unavailable; memoryTheme carries it.
    }
  }

  const NEXT: Record<string, string> = { system: 'light', light: 'dark', dark: 'system' };

  function applyTheme(theme: string) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
  }

  // Every instance shows the same state, so all of them update together. The
  // label names the current theme and what a press does, since the icon alone
  // doesn't tell a screen reader user either.
  function updateIcons() {
    const theme = getTheme();
    document.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
      icon.classList.toggle('hidden', icon.dataset.themeIcon !== theme);
    });
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', `Theme: ${theme}. Switch to ${NEXT[theme]}`);
    });
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = NEXT[getTheme()] ?? 'system';
      storeTheme(next);
      applyTheme(next);
      updateIcons();
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getTheme() === 'system') {
      applyTheme('system');
    }
  });

  updateIcons();
</script>

<style>
  /* Without JS every icon stays hidden and a press does nothing, which leaves
     an invisible, focusable dead button. Remove it; the OS theme still applies. */
  html:not(.js) [data-theme-toggle] {
    display: none;
  }
</style>
