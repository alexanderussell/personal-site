---
import { Sprout, Leaf, TreePine } from 'lucide-astro';

interface Props {
  status: 'seedling' | 'growing' | 'evergreen';
}

const { status } = Astro.props;

const stageNotes: Record<Props['status'], string> = {
  seedling: 'Seedling — early, unfinished thinking. Could be wrong.',
  growing: 'Growing — a position in progress. Still being argued with.',
  evergreen: 'Evergreen — settled. I stand behind this one.',
};

const stageIcons = {
  seedling: Sprout,
  growing: Leaf,
  evergreen: TreePine,
} as const;

const StageIcon = stageIcons[status];
---

<span class={`growth-stage growth-stage--${status}`} title={stageNotes[status]} aria-label={stageNotes[status]}>
  <span class="growth-stage__icon" aria-hidden="true">
    <StageIcon class="size-3.5" />
  </span>
  {status}
</span>

<style>
  .growth-stage {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    cursor: help;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .growth-stage:hover {
    color: var(--color-text-primary);
  }

  /* Border firms up as the thinking does. */
  .growth-stage--seedling {
    --growth-color: #a3e635;
    border-style: dashed;
  }

  .growth-stage--growing {
    --growth-color: #4ade80;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-border) 50%, var(--growth-color));
  }

  .growth-stage--evergreen {
    --growth-color: #22c55e;
    border-style: solid;
    border-color: color-mix(in srgb, var(--color-border) 35%, var(--growth-color));
  }

  .growth-stage__icon {
    line-height: 0;
    color: var(--growth-color);
  }
</style>
