---
// VinylPreview.astro
// Spinning vinyl record preview for the experiments timeline.
// Links out to vinyl.alexanderussell.com. The whole preview is one link: the
// disc is the obvious thing to click, so it has to be the target, not just the
// label under it.
---

<a
  href="https://vinyl.alexanderussell.com"
  class="vinyl-preview"
  target="_blank"
  rel="noopener noreferrer"
  data-vinyl-preview
>
  <div class="vinyl-preview-stage" aria-hidden="true">
    <div class="vinyl-disc">
      <div class="vinyl-groove vinyl-groove-1"></div>
      <div class="vinyl-groove vinyl-groove-2"></div>
      <div class="vinyl-groove vinyl-groove-3"></div>
      <div class="vinyl-groove vinyl-groove-4"></div>
      <div class="vinyl-groove vinyl-groove-5"></div>
      <div class="vinyl-label">
        <div class="vinyl-label-text">DR</div>
        <div class="vinyl-spindle"></div>
      </div>
      <div class="vinyl-sheen"></div>
    </div>
  </div>
  <span class="vinyl-preview-cta">
    Open experiment <span aria-hidden="true">&nearr;</span>
    <span class="sr-only">(opens in a new tab)</span>
  </span>
</a>

<style>
  /* Sized to its contents so the empty column either side isn't a click target. */
  .vinyl-preview {
    text-decoration: none;
    width: fit-content;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .vinyl-preview-stage {
    width: 180px;
    height: 180px;
    position: relative;
    cursor: pointer;
  }

  .vinyl-disc {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    position: relative;
    background: radial-gradient(circle at center,
      #1a1a1a 0%, #0d0d0d 14%, #1a1a1a 15%, #111 28%, #1a1a1a 29%,
      #0f0f0f 43%, #1a1a1a 44%, #111 58%, #1a1a1a 59%,
      #0d0d0d 73%, #1a1a1a 74%, #111 88%, #1a1a1a 89%, #0d0d0d 100%);
    box-shadow: 0 4px 30px rgba(0,0,0,0.4), inset 0 0 15px rgba(0,0,0,0.3);
    animation: vinyl-spin 3s linear infinite;
  }

  .vinyl-groove {
    position: absolute;
    border-radius: 50%;
    border: 0.5px solid rgba(50,50,50,0.25);
    pointer-events: none;
  }
  .vinyl-groove-1 { inset: 12px; }
  .vinyl-groove-2 { inset: 22px; }
  .vinyl-groove-3 { inset: 32px; }
  .vinyl-groove-4 { inset: 42px; }
  .vinyl-groove-5 { inset: 52px; }

  .vinyl-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: radial-gradient(circle, #3a2a1a 0%, #2a1c10 60%, #1a1008 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 6px rgba(0,0,0,0.5);
  }

  .vinyl-label-text {
    font-family: 'Georgia', serif;
    font-size: 14px;
    font-weight: 400;
    font-style: italic;
    color: rgba(180, 140, 80, 0.6);
    letter-spacing: 2px;
  }

  .vinyl-spindle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0a0a0a;
    box-shadow: inset 0 0 2px rgba(0,0,0,0.9);
  }

  .vinyl-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 200deg, transparent 0%, rgba(255,255,255,0.03) 10%, transparent 20%, transparent 100%);
    pointer-events: none;
  }

  /* The live experiment is the point of the page ("real beats rendered"), so
     its way in reads as the primary action rather than a caption. */
  .vinyl-preview-cta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    transition: border-color 0.3s, background-color 0.3s;
  }

  .vinyl-preview:hover .vinyl-preview-cta,
  .vinyl-preview:focus-visible .vinyl-preview-cta {
    border-color: var(--color-accent);
    background: var(--color-bg-secondary);
  }

  @keyframes vinyl-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-disc {
      animation: none;
    }
  }
</style>
