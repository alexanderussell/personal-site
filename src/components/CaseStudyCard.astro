---
interface Props {
  href: string;
  title: string;
  description: string;
  role?: string;
  timeline?: string;
  tags?: string[];
  /** Compact variant for the homepage preview, where vertical space is tighter. */
  compact?: boolean;
}

const { href, title, description, role, timeline, tags = [], compact = false } = Astro.props;

const meta = [role, timeline].filter(Boolean);
---

<a href={href} class:list={['case-card', compact && 'case-card--compact']}>
  {meta.length > 0 && (
    <div class="case-card__meta font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
      {meta.join(' · ')}
    </div>
  )}

  <h3 class="case-card__title mt-1.5 font-semibold">{title}</h3>
  <p class="text-text-secondary mt-1 text-sm leading-relaxed">{description}</p>

  {!compact && tags.length > 0 && (
    <ul class="case-card__tags mt-3">
      {tags.map((tag) => (
        <li class="case-card__tag font-mono text-[11px] text-text-secondary">{tag}</li>
      ))}
    </ul>
  )}
</a>

<style>
  .case-card {
    display: block;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .case-card:hover {
    border-color: var(--color-accent);
  }

  .case-card__title {
    color: var(--color-text-primary);
    font-size: 1.0625rem;
  }

  .case-card:hover .case-card__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .case-card--compact {
    padding: 1rem 1.125rem;
  }

  .case-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .case-card__tag {
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
  }
</style>
