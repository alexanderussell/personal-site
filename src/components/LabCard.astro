---
import LabMotif from './LabMotif.astro';
import GrowthStage from './GrowthStage.astro';

interface Props {
  id: string;
  href: string;
  title: string;
  description: string;
  date: Date;
  status?: 'seedling' | 'growing' | 'evergreen';
  /** Whether this experiment has a renderable preview component. */
  hasPreview?: boolean;
}

const { id, href, title, description, date, status, hasPreview = true } = Astro.props;
---

<article class="lab-card">
  {hasPreview && (
    <div class="lab-card__stage">
      <LabMotif id={id} />
    </div>
  )}

  <div class="lab-card__body">
    <div class="flex items-baseline gap-3">
      <time
        class="text-text-secondary font-mono text-[13px]"
        datetime={date.toISOString()}
      >
        {date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}
      </time>
      {status && <GrowthStage status={status} />}
    </div>

    <h2 class="mt-2 text-lg font-semibold">
      <a href={href} class="lab-card__link">{title}</a>
    </h2>
    <p class="text-text-secondary mt-1 text-sm leading-relaxed">{description}</p>
  </div>
</article>

<style>
  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: border-color 0.3s ease;
  }

  .lab-card:hover,
  .lab-card:focus-within {
    border-color: var(--color-type-experiment);
  }

  /* The preview is decorative chrome around the real link. Contain it so a
     wide experiment can't push the card out of the grid. */
  .lab-card__stage {
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-bg-secondary);
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
  }

  .lab-card__body {
    flex: 1;
  }

  /* Stretched link — the whole card is the target, but the accessible name
     stays on the title text rather than being swallowed by the preview. */
  .lab-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .lab-card {
    position: relative;
  }

  .lab-card__link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .lab-card:hover .lab-card__link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
