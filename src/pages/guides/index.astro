---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import TimelineItem from '../../components/TimelineItem.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Guides — Alex Russell" description="Playbooks, practical frameworks, and tactical deep dives.">
  <section class="py-16">
    <h1 class="section-title">Guides</h1>
    <p class="section-lede">Repeatable systems and frameworks, written down after they worked more than once.</p><div class="mt-12">
      {guides.map((guide, index) => (
        <TimelineItem
          href={`/guides/${guide.id}`}
          type="guide"
          title={guide.data.title}
          description={guide.data.description}
          date={guide.data.date}
          isLast={index === guides.length - 1}
          showTypeLabel={false}
        />
      ))}
    </div>
  </section>
</BaseLayout>
