---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import TimelineItem from '../../components/TimelineItem.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Notes — Alex Russell" description="Essays and arguments about design, engineering, and what AI is doing to both.">
  <section class="py-16">
    <h1 class="section-title">Notes</h1>
    <p class="section-lede">Essays. A few are settled; most are still moving.</p><div class="mt-12">
      {notes.map((note, index) => (
        <TimelineItem
          href={`/notes/${note.id}`}
          type="note"
          title={note.data.title}
          description={note.data.description}
          date={note.data.date}
          isLast={index === notes.length - 1}
          showTypeLabel={false}
        />
      ))}
    </div>
  </section>
</BaseLayout>
