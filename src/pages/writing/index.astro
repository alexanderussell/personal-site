---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingRow from '../../components/WritingRow.astro';
import { SubscribeForm } from '../../components/SubscribeForm';
import { getWritingEntries } from '../../lib/writing';

// Deliberately the only data call on this page. Listings read from the
// normalized shape so a second source (a Substack feed) can be added as
// another producer rather than a rewrite of this page.
const entries = await getWritingEntries();

const noteCount = entries.filter((e) => e.kind === 'note').length;
const guideCount = entries.filter((e) => e.kind === 'guide').length;
---

<BaseLayout
  title="Writing — Alex Russell"
  description="Essays and guides on design engineering, developer experience, and what AI is doing to craft."
>
  <section class="py-16">
    <p class="font-mono text-sm font-semibold tracking-tight uppercase text-text-secondary">Writing</p>
    <h1 class="font-heading mt-3 text-xl leading-snug sm:text-2xl sm:leading-[1.35]">
      Essays written with conviction and edited with doubt.
    </h1>

    <p class="text-text-secondary mt-4 max-w-2xl font-mono text-sm leading-7">
      {noteCount} {noteCount === 1 ? 'essay' : 'essays'} and {guideCount}
      {guideCount === 1 ? 'guide' : 'guides'}. Essays argue a position; guides are the
      repeatable version of something I worked out the hard way.
    </p>

    {entries.length > 0 ? (
      <div class="mt-12">
        {entries.map((entry) => (
          <WritingRow entry={entry} />
        ))}
      </div>
    ) : (
      <p class="text-text-secondary mt-12 font-mono text-sm">Nothing published yet.</p>
    )}

    <div class="mt-16 border-t border-border/50 pt-10">
      <h2 class="font-heading text-lg">Get new pieces by email</h2>
      <p class="text-text-secondary mt-1 font-mono text-sm leading-7">
        New essays and experiments, straight to your inbox. No cadence promises.
      </p>
      <div class="mt-4">
        <SubscribeForm client:visible list="newsletter" />
      </div>
    </div>
  </section>
</BaseLayout>
