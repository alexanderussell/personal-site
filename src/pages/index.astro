---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import SectionPreview from '../components/SectionPreview.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import LabCard from '../components/LabCard.astro';
import WritingRow from '../components/WritingRow.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { User, BookMarked } from 'lucide-astro';
import { getWritingEntries } from '../lib/writing';
import { hasPreview } from '../lib/lab';
import { heroPortrait } from '../data/photos';
import { site } from '../data/site';

const workEntries = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => {
    // Featured first, then most recent.
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 3);

const labEntries = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const writingEntries = (await getWritingEntries()).slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero pt-12">
    <div class="hero__copy flex flex-col gap-3">
      {/*
        The statement revises itself in place: "designer who builds" is struck
        through and replaced by "builder who designs". <del>/<ins> are HTML's
        own edit markup, so the revision is real semantics rather than styled
        spans — assistive tech announces it as a deletion and an insertion, and
        with JS off the line reads as an edited manuscript, which is the point.
      */}
      <h1 class="hero__statement fade-in-hidden" data-stagger>
        Alex is a
        <span class="hero__revise" data-revise>
          <del class="hero__was">designer who builds</del>
          <ins class="hero__now">builder who designs</ins>
        </span>
      </h1>

      <p class="hero__lede fade-in-hidden" data-stagger>
        Twelve years of making software feel like something. Right now I lead UX for developer
        tools at <a href="https://marriott.com" id="marriott-link" class="link-inline" target="_blank" rel="noopener noreferrer">Marriott International</a>, designing the internal
        platforms that engineering teams use to ship infrastructure.
      </p>
      <p class="hero__lede fade-in-hidden" data-stagger>
        Before that, I spent years inside agencies, dev shops, and startups — wearing every hat, shipping everything from
        brand systems to full product builds. Somewhere in the middle I started a design collective called <a href="https://collectivelymade.com" id="cm-link" target="_blank" rel="noopener noreferrer" class="link-inline">Collectively Made</a>.
      </p>

      <p class="hero__contact font-mono fade-in-hidden" data-stagger>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <div class="hero__portrait fade-in-hidden" data-stagger>
      <PhotoFrame photo={heroPortrait} eager />
    </div>
  </section>

  <!-- Tooltips -->
  <div class="hover-tooltip" id="marriott-tooltip"></div>
  <div class="hover-tooltip" id="cm-tooltip"></div>

  <!-- CTA row — extensible flex container for homepage buttons -->
  <div class="flex gap-3 mt-16 fade-in-hidden" data-stagger>
    <a
      href="/about"
      class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.12em] text-text-secondary border border-border px-3.5 py-1.5 rounded-md hover:text-text-primary hover:border-accent transition-all duration-300"
    >
      <User class="size-3.5 opacity-40" aria-hidden="true" />
      About Me
    </a>
    <a
      href="/book"
      class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.12em] text-text-secondary border border-border px-3.5 py-1.5 rounded-md hover:text-text-primary hover:border-accent transition-all duration-300"
    >
      <BookMarked class="size-3.5 opacity-40" aria-hidden="true" />
      My Book
    </a>
  </div>

  <div class="mt-8">
    <!-- Work — rendered only once there is a published case study, so an empty
         section doesn't leave a hole above the fold. -->
    {workEntries.length > 0 && (
      <div class="fade-in-hidden" data-section-animate>
        <SectionPreview label="Work" href="/work">
          <div class="home-grid home-grid--work">
            {workEntries.map((entry) => (
              <CaseStudyCard
                href={`/work/${entry.id}`}
                title={entry.data.title}
                description={entry.data.description}
                role={entry.data.company}
                timeline={entry.data.timeline}
                compact
              />
            ))}
          </div>
        </SectionPreview>
      </div>
    )}

    {labEntries.length > 0 && (
      <div class="fade-in-hidden" data-section-animate>
        <SectionPreview label="Lab" href="/lab">
          <div class="home-grid home-grid--lab">
            {labEntries.map((entry) => (
              <LabCard
                id={entry.id}
                href={`/lab/${entry.id}`}
                title={entry.data.title}
                description={entry.data.description}
                date={entry.data.date}
                status={entry.data.status}
                hasPreview={hasPreview(entry.id)}
              />
            ))}
          </div>
        </SectionPreview>
      </div>
    )}

    {writingEntries.length > 0 && (
      <div class="fade-in-hidden" data-section-animate>
        <SectionPreview label="Writing" href="/writing">
          <div>
            {writingEntries.map((entry) => (
              <WritingRow entry={entry} />
            ))}
          </div>
        </SectionPreview>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  /* Copy first on mobile, portrait beside it once there's room. The portrait
     is supporting evidence, not the headline — it never leads. */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Same reasoning as the About portrait: uncapped, a square frame at mobile
     width pushes the copy below the fold. */
  .hero__portrait {
    max-width: 11rem;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 2.5rem;
    }

    .hero__portrait {
      max-width: none;
    }
  }

  /* ── The revising statement ──
     Base state is the finished edit: struck original, visible revision. JS only
     *sequences* that reveal, so no-JS and reduced-motion visitors get the same
     meaning without the choreography. */
  .hero__statement {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .hero__revise {
    display: inline;
  }

  .hero__was,
  .hero__now {
    text-decoration: none;
  }

  .hero__was {
    position: relative;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* The strike is drawn, not a text-decoration, so it can be animated as a
     line sweeping across the phrase. */
  .hero__was::after {
    content: '';
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    top: 0.56em;
    height: 0.06em;
    background: currentColor;
    transform-origin: left center;
  }

  .hero__now {
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  /* With JS, start from the un-revised line and play the edit once. */
  html.js .hero__was::after {
    transform: scaleX(0);
  }

  html.js .hero__now {
    opacity: 0;
  }

  html.js .hero__statement.is-revised .hero__was::after {
    transform: scaleX(1);
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.js .hero__statement.is-revised .hero__now {
    opacity: 1;
    transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1) 380ms;
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .hero__was::after {
      transform: scaleX(1);
    }

    html.js .hero__now {
      opacity: 1;
    }

    html.js .hero__statement.is-revised .hero__was::after,
    html.js .hero__statement.is-revised .hero__now {
      transition: none;
    }
  }

  /* Running prose is Inter, not JetBrains Mono. Monospace at 15-16px slows
     reading measurably and reads as costume rather than as measurement — the
     mono is reserved for dates, types, and labels. */
  .hero__lede {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 40rem;
    text-wrap: pretty;
  }

  .hero__contact {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-top: 0.5rem;
  }

  .hero__contact a {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    padding-bottom: 1px;
    transition: color 0.3s ease;
  }

  .hero__contact a:hover {
    color: var(--color-text-primary);
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  @media (min-width: 640px) {
    .home-grid--lab {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .home-grid--work {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  // ── Stagger animate hero elements, then section previews ──
  const staggerItems = document.querySelectorAll('[data-stagger]');
  const sectionItems = document.querySelectorAll('[data-section-animate]');

  let delay = 100;
  staggerItems.forEach((item) => {
    setTimeout(() => item.classList.add('is-visible'), delay);
    delay += 120;
  });

  // ── The statement revises itself, once, after it has settled ──
  // The CSS default is already the finished edit; this only sequences it, so
  // no-JS and reduced-motion visitors still read the revised line.
  const statement = document.querySelector('.hero__statement');
  if (statement) {
    setTimeout(() => statement.classList.add('is-revised'), 900);
  }

  // Sections stagger in after the intro paragraphs
  delay += 100;
  sectionItems.forEach((item) => {
    setTimeout(() => item.classList.add('is-visible'), delay);
    delay += 80;
  });

  // ── Rotating tooltips ──
  function setupTooltip(linkId: string, tooltipId: string, phrases: string[]) {
    const link = document.getElementById(linkId)!;
    const tooltip = document.getElementById(tooltipId)!;
    let index = 0;

    link.addEventListener('mouseenter', () => {
      tooltip.textContent = phrases[index % phrases.length];
      index++;
      tooltip.classList.add('is-visible');
    });

    link.addEventListener('mouseleave', () => {
      tooltip.classList.remove('is-visible');
    });

    link.addEventListener('mousemove', (e: MouseEvent) => {
      tooltip.style.left = `${e.clientX + 12}px`;
      tooltip.style.top = `${e.clientY - 32}px`;
    });
  }

  setupTooltip('marriott-link', 'marriott-tooltip', [
    '🏨 yes, the hotel people',
    '🛎️ the towel-folding empire',
    '✈️ points guy paradise',
  ]);

  setupTooltip('cm-link', 'cm-tooltip', [
    '🤝 we made things, collectively',
    '🧥 a bunch of designers in a trench coat',
    '💭 the "we should start a studio" phase',
  ]);
</script>
